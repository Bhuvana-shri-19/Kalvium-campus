# ==============================================================================
# Kalvium Campus Navigator & Request Processing Simulator - Backend Environment
# ==============================================================================
# This template documents required and optional environment variables for the
# Express backend development server.
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY NOTICE:
# Do not store production secrets, private encryption keys, or sensitive database
# credentials in this file or commit `.env` to source control.
# ==============================================================================

# Port on which the Express HTTP server listens
PORT=5000

# Runtime environment ('development' | 'production' | 'test')
# In 'development', detailed error traces and diagnostics are provided.
# In 'production', stack traces are concealed and generic error responses are emitted.
NODE_ENV=development

# Development frontend origin allowed by CORS middleware (Vite development server)
CLIENT_URL=http://localhost:5173
