{
  "name": "kalvium-campus-simulator",
  "version": "1.0.0",
  "description": "Kalvium Campus Navigator & Request Processing Simulator full-stack application",
  "private": true,
  "type": "module",
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "build:cpp": "node scripts/build-cpp.js",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:cpp && npm run build:frontend",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
