# ==============================================================================
# Kalvium Campus Navigator & Request Processing Simulator
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js + Express)
# ------------------------------------------------------------------------------
# Port on which the Express HTTP server listens (cloud platforms set this dynamically)
PORT=5000

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=production

# Allowed frontend origin for CORS in development (when running Vite on port 5173)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Base URL for the Express REST API.
# - In local development: http://localhost:5000/api
# - In monolithic production (when backend serves frontend/dist): /api
# - In split cloud deployment (Vercel + Render): https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
